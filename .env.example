# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="replace-with-32-char-minimum-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron (Phase 5)
CRON_SECRET="dev-cron-secret"

# Trigger.dev (background analysis)
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_REF="proj_REPLACE_ME"
STOCKFISH_PATH="/usr/games/stockfish"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Endgame <onboarding@resend.dev>"

# Pusher (PvP realtime)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# Gemini AI (Phase 3) — only gemini-3.5-flash-lite and gemini-3.1-flash-lite are supported
GEMINI_API_KEY=""
AI_PROVIDER="gemini"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

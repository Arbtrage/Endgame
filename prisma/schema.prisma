generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GameMode {
  COMPUTER
  AI_OPPONENT
  COACH
  PVP
}

enum GameStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum GameResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
  ABANDONED
}

enum AnalysisJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id                 String   @id @default(cuid())
  name               String?
  email              String   @unique
  emailVerified      Boolean  @default(false)
  image              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  skillEstimate      Int?
  onboardingComplete Boolean  @default(false)

  accounts Account[]
  sessions Session[]
  settings UserSettings?
  games           Game[]
  whiteGames      Game[]       @relation("WhiteGames")
  blackGames      Game[]       @relation("BlackGames")
  sentInvites     GameInvite[] @relation("SentInvites")
  receivedInvites GameInvite[] @relation("ReceivedInvites")
  chatSessions    ChatSession[]
  gameMessages    GameMessage[]
  trainingLessons TrainingLesson[]
  lessonProgress  LessonProgress[]
  weeklyReports   WeeklyReport[]
  analyses        Analysis[]
  analysisJobs    AnalysisJob[]

  @@map("users")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  boardTheme            String   @default("classic")
  pieceSet              String   @default("standard")
  soundEnabled          Boolean  @default(true)
  defaultStockfishLevel Int      @default(5)
  defaultAiPersonality  String   @default("intermediate")
  coachAutoExplain      Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Game {
  id                   String      @id @default(cuid())
  userId               String
  mode                 GameMode
  status               GameStatus  @default(IN_PROGRESS)
  result               GameResult?
  resultReason         String?
  playerColor          String
  stockfishLevel       Int?
  aiPersonality        String?
  timeControlInitial   Int?
  timeControlIncrement Int?
  pgn                  String?
  finalFen             String?
  moveCount            Int         @default(0)
  whiteUserId          String?
  blackUserId          String?
  pendingDrawOfferUserId String?
  pendingDrawOfferAt     DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  completedAt          DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  whiteUser    User?         @relation("WhiteGames", fields: [whiteUserId], references: [id], onDelete: SetNull)
  blackUser    User?         @relation("BlackGames", fields: [blackUserId], references: [id], onDelete: SetNull)
  moves        Move[]
  messages     GameMessage[]
  coachMoments CoachMoment[]
  analyses     Analysis[]
  analysisJobs AnalysisJob[]
  invite       GameInvite?

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([whiteUserId])
  @@index([blackUserId])
  @@map("games")
}

model GameInvite {
  id                   String       @id @default(cuid())
  token                String       @unique @default(cuid())
  inviterId            String
  inviteeId            String
  status               InviteStatus @default(PENDING)
  inviterColor         String
  timeControlInitial   Int?
  timeControlIncrement Int?
  gameId               String?      @unique
  expiresAt            DateTime
  createdAt            DateTime     @default(now())
  respondedAt          DateTime?

  inviter User  @relation("SentInvites", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User  @relation("ReceivedInvites", fields: [inviteeId], references: [id], onDelete: Cascade)
  game    Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([inviteeId, status])
  @@index([inviterId, status])
  @@map("game_invites")
}

model GameMessage {
  id        String   @id @default(cuid())
  gameId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@map("game_messages")
}

model Move {
  id         String   @id @default(cuid())
  gameId     String
  moveNumber Int
  san        String
  uci        String
  fen        String
  color      String
  createdAt  DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, moveNumber])
  @@index([gameId])
  @@map("moves")
}

model CoachMoment {
  id          String   @id @default(cuid())
  gameId      String
  moveNumber  Int
  momentType  String
  evalBefore  Float
  evalAfter   Float
  explanation String
  createdAt   DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("coach_moments")
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  context   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

enum LessonStatus {
  GENERATING
  READY
  ARCHIVED
}

enum LessonTopic {
  TACTICS
  ENDGAME
  OPENING
  POSITIONAL
  CUSTOM
}

model Analysis {
  id              String   @id @default(cuid())
  gameId          String
  userId          String
  analysisMode    String?
  analysisDepth   Int?
  accuracy        Float
  acpl            Float
  totalMoves      Int
  blunderCount    Int      @default(0)
  mistakeCount    Int      @default(0)
  inaccuracyCount Int      @default(0)
  brilliantCount  Int      @default(0)
  moveAnalysis    Json
  evalGraph       Json
  summary         String?
  keyMoments      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("analyses")
}

model AnalysisJob {
  id           String            @id @default(cuid())
  gameId       String
  userId       String
  status       AnalysisJobStatus @default(PENDING)
  analysisMode String            @default("standard")
  triggerRunId String?
  errorMessage String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  completedAt  DateTime?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([status])
  @@index([userId, createdAt(sort: Desc)])
  @@map("analysis_jobs")
}

model TrainingLesson {
  id             String       @id @default(cuid())
  userId         String
  title          String
  description    String
  topic          LessonTopic
  difficulty     Int
  status         LessonStatus @default(GENERATING)
  sourceWeakness String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises Exercise[]
  progress  LessonProgress[]

  @@index([userId, status])
  @@map("training_lessons")
}

model Exercise {
  id          String   @id @default(cuid())
  lessonId    String
  orderIndex  Int
  fen         String
  objective   String
  solutionUci String
  hintLevels  Json
  explanation String
  createdAt   DateTime @default(now())

  lesson TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, orderIndex])
  @@map("exercises")
}

model LessonProgress {
  id              String    @id @default(cuid())
  userId          String
  lessonId        String
  currentExercise Int       @default(0)
  completed       Boolean   @default(false)
  score           Float?
  exerciseResults Json?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model WeeklyReport {
  id               String   @id @default(cuid())
  userId           String
  weekStart        DateTime
  weekEnd          DateTime
  gamesPlayed      Int      @default(0)
  lessonsCompleted Int      @default(0)
  avgAccuracy      Float?
  weaknessTags     Json
  narrative        String
  stats            Json
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId, weekStart(sort: Desc)])
  @@map("weekly_reports")
}
